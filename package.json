{
	"name": "inventory-dashboard",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --hostname 0.0.0.0",
		"dev:socket": "tsx watch server/socket.ts",
		"dev:all": "concurrently -k \"yarn:dev\" \"yarn:dev:socket\"",
		"build": "next build",
		"start": "next start --hostname 0.0.0.0",
		"start:socket": "tsx server/socket.ts",
		"start:all": "concurrently -k \"yarn:start\" \"yarn:start:socket\"",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.13.0",
		"lucide-react": "^1.56.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-redux": "^9.3.0",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"concurrently": "^10.0.6",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.4.0",
		"prettier": "^3.9.10",
		"sass": "^1.105.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^7",
		"vitest": "^5.0.4"
	}
}
